# Qloo hackathon key. Server-side only. Leave unset to run on recorded fixtures.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
# Force fixtures even when a key is present: QLOO_MODE=mock
QLOO_MODE=
# Optional. Enables the Claude-powered agent chat and the live LLM-only baseline.
ANTHROPIC_API_KEY=
