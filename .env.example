# Qloo hackathon key. Server-side only. Leave unset to run on synthetic demo data.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
# Force synthetic demo data even when a key is present: QLOO_MODE=mock
QLOO_MODE=
# Optional. Enables the Claude tool-use agent in the chat. Without it the chat
# runs a deterministic offline planner over the same Qloo-derived plan.
ANTHROPIC_API_KEY=
